#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="${1:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
FIXTURE="$(mktemp -d)"

cleanup() {
  rm -rf "$FIXTURE"
}
trap cleanup EXIT

fail() {
  printf 'prepare-release contract failed: %s\n' "$*" >&2
  exit 1
}

expect_rejected() {
  local expected="$1"
  shift
  local output
  if output="$("$@" 2>&1)"; then
    fail "unsafe invocation unexpectedly passed: $*"
  fi
  [[ "$output" == *"$expected"* ]] || fail "unexpected rejection: $output"
}

mkdir -p "$FIXTURE/scripts" "$FIXTURE/docs/releases"
cp "$ROOT_DIR/scripts/prepare-release" "$FIXTURE/scripts/prepare-release"
cp "$ROOT_DIR/scripts/release-version-files.txt" "$FIXTURE/scripts/release-version-files.txt"
chmod +x "$FIXTURE/scripts/prepare-release"

while IFS= read -r relative; do
  [[ -n "$relative" && "$relative" != \#* ]] || continue
  mkdir -p "$FIXTURE/$(dirname "$relative")"
  printf 'current=0.1.0-alpha.1\n' > "$FIXTURE/$relative"
done < "$FIXTURE/scripts/release-version-files.txt"

cat > "$FIXTURE/scripts/publish-sdk" <<'EOF'
#!/usr/bin/env bash
# Fixture current version: 0.1.0-alpha.1
set -euo pipefail
[[ "$*" == "--print" ]]
touch .git/prepare-release-publish-preview-called
EOF
cat > "$FIXTURE/gradlew" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
[[ "$*" == "verifySdkQuick" ]]
touch .git/prepare-release-quick-gate-called
EOF
chmod +x "$FIXTURE/scripts/publish-sdk" "$FIXTURE/gradlew"

printf 'magrathea.version=0.1.0-alpha.1\n' > "$FIXTURE/gradle.properties"
cat > "$FIXTURE/CHANGELOG.md" <<'EOF'
# Changelog

## Unreleased

### Added

- A safer release entry point.

## 0.1.0-alpha.1 — 2026-08-01

- Initial release.
EOF
git -C "$FIXTURE" init -q -b main
git -C "$FIXTURE" config user.name "Magrathea Contract"
git -C "$FIXTURE" config user.email "contract@example.invalid"
git -C "$FIXTURE" add .
git -C "$FIXTURE" commit -q -m fixture

"$FIXTURE/scripts/prepare-release" 0.1.0-alpha.2 --date 2026-08-19 --dry-run >/dev/null
[[ -z "$(git -C "$FIXTURE" status --porcelain)" ]] || fail "dry-run changed the fixture"

prepare_output="$(
  "$FIXTURE/scripts/prepare-release" 0.1.0-alpha.2 --date 2026-08-19
)"
[[ "$prepare_output" == *"scripts/release 0.1.0-alpha.2"* ]] ||
  fail "preparation did not hand off to the release orchestrator"
[[ "$prepare_output" != *"gh workflow run release.yml"* ]] ||
  fail "preparation still exposes the low-level workflow dispatch"
[[ -f "$FIXTURE/.git/prepare-release-publish-preview-called" ]] ||
  fail "publication coordinates were not previewed"
[[ -f "$FIXTURE/.git/prepare-release-quick-gate-called" ]] ||
  fail "verifySdkQuick was not run"
grep -Fxq 'magrathea.version=0.1.0-alpha.2' "$FIXTURE/gradle.properties" ||
  fail "version property was not updated"
grep -Fq '## 0.1.0-alpha.2 — 2026-08-19' "$FIXTURE/CHANGELOG.md" ||
  fail "Unreleased changes were not promoted"
grep -Fq 'A safer release entry point.' "$FIXTURE/docs/releases/v0.1.0-alpha.2.md" ||
  fail "release notes were not generated from the changelog"
while IFS= read -r relative; do
  [[ -n "$relative" && "$relative" != \#* ]] || continue
  grep -Fq '0.1.0-alpha.2' "$FIXTURE/$relative" || fail "$relative was not updated"
done < "$FIXTURE/scripts/release-version-files.txt"

git -C "$FIXTURE" add .
git -C "$FIXTURE" commit -q -m "prepare alpha.2"
expect_rejected "must have higher SemVer precedence" \
  "$FIXTURE/scripts/prepare-release" 0.1.0-alpha.1 --skip-verify
expect_rejected "not a valid YYYY-MM-DD date" \
  "$FIXTURE/scripts/prepare-release" 0.1.0-alpha.3 --date 2026-02-30 --skip-verify

printf '# Changelog\n\n## Unreleased\n\n## 0.1.0-alpha.2 — 2026-08-19\n' > \
  "$FIXTURE/CHANGELOG.md"
git -C "$FIXTURE" add CHANGELOG.md
git -C "$FIXTURE" commit -q -m "empty unreleased fixture"
expect_rejected "'## Unreleased' is empty" \
  "$FIXTURE/scripts/prepare-release" 0.1.0-alpha.3 --skip-verify

printf 'dirty\n' >> "$FIXTURE/README.md"
expect_rejected "git worktree is not clean" \
  "$FIXTURE/scripts/prepare-release" 0.1.0-alpha.3 --skip-verify

printf '%s%s\n' \
  'MAGRATHEA_PREPARE_RELEASE_CONTRACT_PASS version=monotonic changelog=promoted' \
  ' notes=generated gates=required'
