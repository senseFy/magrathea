#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

PROJECT_DIR="$DEFAULT_ROOT"
REPOSITORY_URL=""
REPOSITORY_NAME="GitHubPackages"
COORDINATES_FILE=""
LOCAL_MAVEN_REPOSITORY=""
COMPLETED_COORDINATES_FILE=""
MANIFEST_FILE=""
TRANSPORT_ATTEMPTS="${MAGRATHEA_REMOTE_TRANSPORT_ATTEMPTS:-4}"
TRANSPORT_RETRY_SECONDS="${MAGRATHEA_REMOTE_TRANSPORT_RETRY_SECONDS:-2}"
PLAN_ONLY=false
EXACT_FILES=false
FRESH_UPLOAD=false

usage() {
  cat <<'USAGE'
Usage:
  scripts/resume-publish-sdk \
    --project-dir DIR \
    --repository-url URL \
    --coordinates-file FILE \
    --local-maven-repository DIR \
    [--manifest-file FILE] \
    [--completed-coordinates-file FILE] \
    [--repository-name NAME] \
    [--exact-files] \
    [--fresh] \
    [--plan-only]

Resume an interrupted immutable Maven publication without overwriting coordinates
that are already present. Every coordinate must belong to one group and version.
Existing files must match the staged Maven repository byte-for-byte. Missing files
inside a partial coordinate are restored from that repository; Gradle publication
tasks run only for coordinates whose complete staged file set is still absent.
Coordinates with trusted completed-task evidence are bound by their staged POM,
because Kotlin/Native and signatures are not byte-reproducible across clean runners.
With --exact-files, wholly absent coordinates are uploaded from the staged,
manifest-bound repository instead of being regenerated by Gradle. --fresh skips
initial remote file probes only after a global POM-absence preflight.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --project-dir)
      [[ $# -ge 2 ]] || {
        printf '%s requires a value\n' "$1" >&2
        exit 2
      }
      PROJECT_DIR="$2"
      shift 2
      ;;
    --local-maven-repository)
      [[ $# -ge 2 ]] || {
        printf '%s requires a value\n' "$1" >&2
        exit 2
      }
      LOCAL_MAVEN_REPOSITORY="$2"
      shift 2
      ;;
    --completed-coordinates-file)
      [[ $# -ge 2 ]] || {
        printf '%s requires a value\n' "$1" >&2
        exit 2
      }
      COMPLETED_COORDINATES_FILE="$2"
      shift 2
      ;;
    --manifest-file)
      [[ $# -ge 2 ]] || {
        printf '%s requires a value\n' "$1" >&2
        exit 2
      }
      MANIFEST_FILE="$2"
      shift 2
      ;;
    --exact-files)
      EXACT_FILES=true
      shift
      ;;
    --fresh)
      FRESH_UPLOAD=true
      shift
      ;;
    --plan-only)
      PLAN_ONLY=true
      shift
      ;;
    --repository-url)
      [[ $# -ge 2 ]] || {
        printf '%s requires a value\n' "$1" >&2
        exit 2
      }
      REPOSITORY_URL="$2"
      shift 2
      ;;
    --repository-name)
      [[ $# -ge 2 ]] || {
        printf '%s requires a value\n' "$1" >&2
        exit 2
      }
      REPOSITORY_NAME="$2"
      shift 2
      ;;
    --coordinates-file)
      [[ $# -ge 2 ]] || {
        printf '%s requires a value\n' "$1" >&2
        exit 2
      }
      COORDINATES_FILE="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      printf 'unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

[[ -n "$REPOSITORY_URL" && -n "$COORDINATES_FILE" &&
  -n "$LOCAL_MAVEN_REPOSITORY" ]] || {
  usage >&2
  exit 2
}
if [[ "$FRESH_UPLOAD" == true && "$EXACT_FILES" != true ]]; then
  printf 'resume publication failed: --fresh requires --exact-files\n' >&2
  exit 2
fi
if [[ "$EXACT_FILES" == true && -z "$MANIFEST_FILE" ]]; then
  printf 'resume publication failed: --exact-files requires --manifest-file\n' >&2
  exit 2
fi
if [[ "$FRESH_UPLOAD" == true && -n "$COMPLETED_COORDINATES_FILE" ]]; then
  printf 'resume publication failed: --fresh cannot use completed-coordinate evidence\n' >&2
  exit 2
fi
[[ "$REPOSITORY_NAME" =~ ^[A-Za-z][A-Za-z0-9_]*$ ]] || {
  printf 'resume publication failed: unsafe repository name\n' >&2
  exit 2
}
[[ "$TRANSPORT_ATTEMPTS" =~ ^[1-9][0-9]*$ &&
  "$TRANSPORT_RETRY_SECONDS" =~ ^[0-9]+$ ]] || {
  printf 'resume publication failed: retry settings must be non-negative integers\n' >&2
  exit 2
}

case "$REPOSITORY_URL" in
  https://*) ;;
  http://127.0.0.1:*|http://localhost:*) ;;
  *)
    printf 'resume publication failed: repository URL must use HTTPS\n' >&2
    exit 2
    ;;
esac

PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"
COORDINATES_FILE="$(
  cd "$(dirname "$COORDINATES_FILE")"
  printf '%s/%s\n' "$PWD" "$(basename "$COORDINATES_FILE")"
)"
LOCAL_MAVEN_REPOSITORY="$(cd "$LOCAL_MAVEN_REPOSITORY" && pwd)"
if [[ -n "$COMPLETED_COORDINATES_FILE" ]]; then
  COMPLETED_COORDINATES_FILE="$(
    cd "$(dirname "$COMPLETED_COORDINATES_FILE")"
    printf '%s/%s\n' "$PWD" "$(basename "$COMPLETED_COORDINATES_FILE")"
  )"
fi
if [[ -n "$MANIFEST_FILE" ]]; then
  MANIFEST_FILE="$(
    cd "$(dirname "$MANIFEST_FILE")"
    printf '%s/%s\n' "$PWD" "$(basename "$MANIFEST_FILE")"
  )"
fi

[[ -x "$PROJECT_DIR/scripts/verify-remote-version-absent" &&
  -x "$PROJECT_DIR/scripts/verify-remote-version-present" ]] || {
  printf 'resume publication failed: remote verification scripts are unavailable\n' >&2
  exit 2
}
if [[ "$EXACT_FILES" == true ]]; then
  [[ -x "$PROJECT_DIR/scripts/write-maven-manifest" ]] || {
    printf 'resume publication failed: Maven manifest writer is unavailable\n' >&2
    exit 2
  }
else
  [[ -x "$PROJECT_DIR/gradlew" ]] || {
    printf 'resume publication failed: Gradle wrapper is missing or not executable\n' >&2
    exit 2
  }
  [[ -d "$PROJECT_DIR/.git" || -f "$PROJECT_DIR/.git" ]] || {
    printf 'resume publication failed: project directory is not a Git checkout\n' >&2
    exit 2
  }
  [[ -z "$(git -C "$PROJECT_DIR" status --porcelain --untracked-files=all)" ]] || {
    printf 'resume publication failed: project checkout must be clean\n' >&2
    exit 2
  }
fi
[[ -s "$COORDINATES_FILE" ]] || {
  printf 'resume publication failed: coordinate inventory is missing or empty\n' >&2
  exit 2
}
[[ -d "$LOCAL_MAVEN_REPOSITORY" ]] || {
  printf 'resume publication failed: local Maven repository is missing\n' >&2
  exit 2
}
if [[ -n "$COMPLETED_COORDINATES_FILE" && ! -s "$COMPLETED_COORDINATES_FILE" ]]; then
  printf 'resume publication failed: completed-coordinate evidence is missing or empty\n' >&2
  exit 2
fi
if [[ "$EXACT_FILES" == true && ! -s "$MANIFEST_FILE" ]]; then
  printf 'resume publication failed: staged Maven manifest is missing or empty\n' >&2
  exit 2
fi

TEMP_ROOT="${TMPDIR:-/tmp}"
WORK_DIR="$(mktemp -d "${TEMP_ROOT%/}/magrathea-resume-publish.XXXXXX")"
NORMALIZED_COORDINATES="$WORK_DIR/coordinates.txt"
NORMALIZED_COMPLETED_COORDINATES="$WORK_DIR/completed-coordinates.txt"
MISSING_COORDINATES="$WORK_DIR/missing-coordinates.txt"
MISSING_TASKS="$WORK_DIR/missing-tasks.tsv"
MISSING_FILES="$WORK_DIR/missing-files.tsv"
PARTIAL_ARTIFACTS="$WORK_DIR/partial-artifacts.txt"
PARTIAL_FILES="$WORK_DIR/partial-files.tsv"
REMOTE_FILE="$WORK_DIR/remote-file"
CREDENTIALS_FILE=""
: > "$NORMALIZED_COORDINATES"
: > "$NORMALIZED_COMPLETED_COORDINATES"
: > "$MISSING_COORDINATES"
: > "$MISSING_TASKS"
: > "$MISSING_FILES"
: > "$PARTIAL_ARTIFACTS"
: > "$PARTIAL_FILES"

cleanup() {
  rm -rf "$WORK_DIR"
}
trap cleanup EXIT

username="${MAGRATHEA_PUBLISH_USERNAME:-${GITHUB_SAIEN_MAVEN_USERNAME:-}}"
password="${MAGRATHEA_PUBLISH_PASSWORD:-${GITHUB_SAIEN_MAVEN_TOKEN:-}}"
if [[ -n "$username" || -n "$password" ]]; then
  if [[ -z "$username" || -z "$password" ]]; then
    printf 'resume publication failed: repository username and password must both be set\n' >&2
    exit 2
  fi
  if [[ "$username" == *$'\n'* || "$username" == *$'\r'* ||
    "$password" == *$'\n'* || "$password" == *$'\r'* ]]; then
    printf 'resume publication failed: repository credentials contain a newline\n' >&2
    exit 2
  fi
  repository_host="${REPOSITORY_URL#*://}"
  repository_host="${repository_host%%/*}"
  repository_host="${repository_host%%:*}"
  CREDENTIALS_FILE="$WORK_DIR/repository.netrc"
  : > "$CREDENTIALS_FILE"
  chmod 0600 "$CREDENTIALS_FILE"
  printf 'machine %s\nlogin %s\npassword %s\n' \
    "$repository_host" "$username" "$password" > "$CREDENTIALS_FILE"
elif [[ "$REPOSITORY_URL" == https://* ]]; then
  printf 'resume publication failed: HTTPS publication requires repository credentials\n' >&2
  exit 2
fi

GROUP=""
VERSION=""
coordinate_count=0
while IFS=: read -r coordinate_group artifact coordinate_version extra; do
  [[ -n "$coordinate_group" && -n "$artifact" && -n "$coordinate_version" &&
    -z "${extra:-}" ]] || {
    printf 'resume publication failed: malformed coordinate input\n' >&2
    exit 2
  }
  [[ "$coordinate_group" =~ ^[A-Za-z0-9_.-]+$ &&
    "$artifact" =~ ^[A-Za-z0-9_.-]+$ &&
    "$coordinate_version" =~ ^[A-Za-z0-9_.-]+$ ]] || {
    printf 'resume publication failed: unsafe coordinate input\n' >&2
    exit 2
  }
  if [[ -z "$GROUP" ]]; then
    GROUP="$coordinate_group"
    VERSION="$coordinate_version"
  fi
  [[ "$coordinate_group" == "$GROUP" && "$coordinate_version" == "$VERSION" ]] || {
    printf 'resume publication failed: all coordinates must share one group and version\n' >&2
    exit 2
  }
  printf '%s:%s:%s\n' "$coordinate_group" "$artifact" "$coordinate_version" \
    >> "$NORMALIZED_COORDINATES"
  coordinate_count=$((coordinate_count + 1))
done < "$COORDINATES_FILE"

[[ "$coordinate_count" -gt 0 ]] || {
  printf 'resume publication failed: no coordinates were provided\n' >&2
  exit 2
}
unique_coordinate_count="$(sort "$NORMALIZED_COORDINATES" | uniq | wc -l | tr -d ' ')"
[[ "$unique_coordinate_count" -eq "$coordinate_count" ]] || {
  printf 'resume publication failed: coordinate inventory contains duplicates\n' >&2
  exit 2
}

if [[ "$EXACT_FILES" == true ]]; then
  generated_manifest="$WORK_DIR/generated-manifest.sha256"
  sorted_generated_manifest="$WORK_DIR/generated-manifest.sorted.sha256"
  sorted_release_manifest="$WORK_DIR/release-manifest.sha256"
  "$PROJECT_DIR/scripts/write-maven-manifest" \
    "$LOCAL_MAVEN_REPOSITORY" \
    "$NORMALIZED_COORDINATES" \
    "$generated_manifest" >/dev/null
  LC_ALL=C sort "$generated_manifest" > "$sorted_generated_manifest"
  LC_ALL=C sort "$MANIFEST_FILE" > "$sorted_release_manifest"
  missing_manifest_entry="$(
    comm -23 "$sorted_generated_manifest" "$sorted_release_manifest" | head -n 1
  )"
  [[ -z "$missing_manifest_entry" ]] || {
    printf 'resume publication failed: staged file is not bound by the release manifest: %s\n' \
      "${missing_manifest_entry#*  }" >&2
    exit 2
  }
fi

completed_coordinate_count=0
if [[ -n "$COMPLETED_COORDINATES_FILE" ]]; then
  while IFS=: read -r coordinate_group artifact coordinate_version extra; do
    [[ -n "$coordinate_group" && -n "$artifact" && -n "$coordinate_version" &&
      -z "${extra:-}" ]] || {
      printf 'resume publication failed: malformed completed-coordinate evidence\n' >&2
      exit 2
    }
    coordinate="$coordinate_group:$artifact:$coordinate_version"
    [[ "$coordinate_group" == "$GROUP" &&
      "$coordinate_version" == "$VERSION" &&
      "$artifact" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ &&
      "$(grep -Fxc "$coordinate" "$NORMALIZED_COORDINATES")" -eq 1 ]] || {
      printf 'resume publication failed: completed coordinate is outside the release inventory: %s\n' \
        "$coordinate" >&2
      exit 2
    }
    printf '%s\n' "$coordinate" >> "$NORMALIZED_COMPLETED_COORDINATES"
    completed_coordinate_count=$((completed_coordinate_count + 1))
  done < "$COMPLETED_COORDINATES_FILE"
  unique_completed_count="$(
    sort "$NORMALIZED_COMPLETED_COORDINATES" | uniq | wc -l | tr -d ' '
  )"
  [[ "$unique_completed_count" -eq "$completed_coordinate_count" ]] || {
    printf 'resume publication failed: completed-coordinate evidence contains duplicates\n' >&2
    exit 2
  }
fi

fetch_file() {
  local url="$1"
  local output="$2"
  local attempt=1
  local status=""

  while [[ "$attempt" -le "$TRANSPORT_ATTEMPTS" ]]; do
    rm -f "$output"
    if [[ -n "$CREDENTIALS_FILE" ]]; then
      status="$(
        curl --silent --show-error --location --output "$output" --write-out '%{http_code}' \
          --connect-timeout 10 --max-time 180 --netrc-file "$CREDENTIALS_FILE" "$url"
      )" || status=""
    else
      status="$(
        curl --silent --show-error --location --output "$output" --write-out '%{http_code}' \
          --connect-timeout 10 --max-time 180 "$url"
      )" || status=""
    fi

    case "$status" in
      200|404)
        REMOTE_STATUS="$status"
        return 0
        ;;
      401|403)
        printf 'resume publication failed: repository authentication was rejected\n' >&2
        return 2
        ;;
      408|429|5??|"")
        if [[ "$attempt" -lt "$TRANSPORT_ATTEMPTS" ]]; then
          sleep "$TRANSPORT_RETRY_SECONDS"
        fi
        ;;
      *)
        printf 'resume publication failed: repository returned HTTP %s\n' "$status" >&2
        return 2
        ;;
    esac
    attempt=$((attempt + 1))
  done
  printf 'resume publication failed: repository download exhausted %s attempts\n' \
    "$TRANSPORT_ATTEMPTS" >&2
  return 2
}

inspect_coordinate_files() {
  local artifact="$1"
  local include_signatures="$2"
  local local_directory="$LOCAL_MAVEN_REPOSITORY/$group_path/$artifact/$VERSION"
  local local_file=""
  local relative_path=""
  local remote_url=""
  local local_digest=""
  local remote_digest=""
  local file_count=0
  local present_file_count=0
  local missing_file_count=0

  [[ -d "$local_directory" &&
    -f "$local_directory/$artifact-$VERSION.pom" ]] || {
    printf 'resume publication failed: staged Maven files are missing for %s\n' \
      "$artifact" >&2
    return 2
  }

  while IFS= read -r local_file; do
    case "$local_file" in
      *.md5|*.sha1|*.sha256|*.sha512) continue ;;
      *.asc)
        [[ "$include_signatures" == true ]] || continue
        ;;
    esac
    relative_path="${local_file#"$LOCAL_MAVEN_REPOSITORY/"}"
    [[ "$relative_path" != "$local_file" &&
      "$relative_path" != *".."* &&
      "$relative_path" =~ ^[A-Za-z0-9_./+@()-]+$ ]] || {
      printf 'resume publication failed: unsafe staged Maven path for %s\n' \
        "$artifact" >&2
      return 2
    }
    remote_url="${REPOSITORY_URL%/}/$relative_path"
    fetch_file "$remote_url" "$REMOTE_FILE" || return $?
    case "$REMOTE_STATUS" in
      200)
        local_digest="$(shasum -a 256 "$local_file" | cut -d' ' -f1)"
        remote_digest="$(shasum -a 256 "$REMOTE_FILE" | cut -d' ' -f1)"
        [[ "$local_digest" == "$remote_digest" ]] || {
          printf 'resume publication failed: existing coordinate %s differs at %s\n' \
            "$artifact" "$relative_path" >&2
          return 2
        }
        present_file_count=$((present_file_count + 1))
        ;;
      404)
        printf '%s\t%s\n' "$local_file" "$relative_path" >> "$PARTIAL_FILES"
        missing_file_count=$((missing_file_count + 1))
        ;;
    esac
    file_count=$((file_count + 1))
  done < <(find "$local_directory" -type f -print | LC_ALL=C sort)

  [[ "$file_count" -gt 0 ]] || {
    printf 'resume publication failed: no staged Maven files were found for %s\n' \
      "$artifact" >&2
    return 2
  }

  COORDINATE_PRESENT_FILES="$present_file_count"
  COORDINATE_MISSING_FILES="$missing_file_count"
}

collect_coordinate_files() {
  local artifact="$1"
  local destination="$2"
  local local_directory="$LOCAL_MAVEN_REPOSITORY/$group_path/$artifact/$VERSION"
  local local_file=""
  local relative_path=""
  local file_count=0

  [[ -d "$local_directory" &&
    -f "$local_directory/$artifact-$VERSION.pom" ]] || {
    printf 'resume publication failed: staged Maven files are missing for %s\n' \
      "$artifact" >&2
    return 2
  }

  while IFS= read -r local_file; do
    case "$local_file" in
      *.md5|*.sha1|*.sha256|*.sha512) continue ;;
    esac
    relative_path="${local_file#"$LOCAL_MAVEN_REPOSITORY/"}"
    [[ "$relative_path" != "$local_file" &&
      "$relative_path" != *".."* &&
      "$relative_path" =~ ^[A-Za-z0-9_./+@()-]+$ ]] || {
      printf 'resume publication failed: unsafe staged Maven path for %s\n' \
        "$artifact" >&2
      return 2
    }
    printf '%s\t%s\n' "$local_file" "$relative_path" >> "$destination"
    file_count=$((file_count + 1))
  done < <(find "$local_directory" -type f -print | LC_ALL=C sort)

  [[ "$file_count" -gt 0 ]] || {
    printf 'resume publication failed: no staged Maven files were found for %s\n' \
      "$artifact" >&2
    return 2
  }
}

verify_completed_coordinate() {
  local artifact="$1"
  local local_pom="$LOCAL_MAVEN_REPOSITORY/$group_path/$artifact/$VERSION/$artifact-$VERSION.pom"
  local remote_url="${REPOSITORY_URL%/}/$group_path/$artifact/$VERSION/$artifact-$VERSION.pom"
  local local_digest=""
  local remote_digest=""

  [[ -f "$local_pom" ]] || {
    printf 'resume publication failed: staged POM is missing for %s\n' "$artifact" >&2
    return 2
  }
  fetch_file "$remote_url" "$REMOTE_FILE" || return $?
  [[ "$REMOTE_STATUS" == 200 ]] || {
    printf 'resume publication failed: completed publication is unavailable for %s\n' \
      "$artifact" >&2
    return 2
  }
  local_digest="$(shasum -a 256 "$local_pom" | cut -d' ' -f1)"
  remote_digest="$(shasum -a 256 "$REMOTE_FILE" | cut -d' ' -f1)"
  [[ "$local_digest" == "$remote_digest" ]] || {
    printf 'resume publication failed: completed publication POM differs for %s\n' \
      "$artifact" >&2
    return 2
  }
}

upload_file() {
  local local_file="$1"
  local relative_path="$2"
  local skip_initial_fetch="${3:-false}"
  local remote_url="${REPOSITORY_URL%/}/$relative_path"
  local attempt=1
  local status=""
  local local_digest=""
  local remote_digest=""
  local content_type="application/octet-stream"

  case "$relative_path" in
    *.pom) content_type="application/xml" ;;
    *.module|*.json) content_type="application/json" ;;
    *.asc) content_type="text/plain" ;;
  esac

  if [[ "$skip_initial_fetch" != true ]]; then
    fetch_file "$remote_url" "$REMOTE_FILE" || return $?
    if [[ "$REMOTE_STATUS" == 200 ]]; then
      local_digest="$(shasum -a 256 "$local_file" | cut -d' ' -f1)"
      remote_digest="$(shasum -a 256 "$REMOTE_FILE" | cut -d' ' -f1)"
      [[ "$local_digest" == "$remote_digest" ]] || {
        printf 'resume publication failed: concurrent file differs at %s\n' \
          "$relative_path" >&2
        return 2
      }
      return 0
    fi
  fi

  while [[ "$attempt" -le "$TRANSPORT_ATTEMPTS" ]]; do
    if [[ -n "$CREDENTIALS_FILE" ]]; then
      status="$(
        curl --silent --show-error --location --output /dev/null --write-out '%{http_code}' \
          --connect-timeout 10 --max-time 120 --netrc-file "$CREDENTIALS_FILE" \
          --header "Content-Type: $content_type" \
          --upload-file "$local_file" "$remote_url"
      )" || status=""
    else
      status="$(
        curl --silent --show-error --location --output /dev/null --write-out '%{http_code}' \
          --connect-timeout 10 --max-time 120 \
          --header "Content-Type: $content_type" \
          --upload-file "$local_file" "$remote_url"
      )" || status=""
    fi
    case "$status" in
      200|201|204)
        return 0
        ;;
      401|403)
        printf 'resume publication failed: repository upload authentication was rejected\n' >&2
        return 2
        ;;
      408|409|429|5??|"")
        if [[ "$status" == 409 ]]; then
          fetch_file "$remote_url" "$REMOTE_FILE" || return $?
          if [[ "$REMOTE_STATUS" == 200 ]]; then
            local_digest="$(shasum -a 256 "$local_file" | cut -d' ' -f1)"
            remote_digest="$(shasum -a 256 "$REMOTE_FILE" | cut -d' ' -f1)"
            [[ "$local_digest" == "$remote_digest" ]] || {
              printf 'resume publication failed: concurrent upload differs at %s\n' \
                "$relative_path" >&2
              return 2
            }
            return 0
          fi
        fi
        if [[ "$attempt" -lt "$TRANSPORT_ATTEMPTS" ]]; then
          sleep "$TRANSPORT_RETRY_SECONDS"
        fi
        ;;
      *)
        printf 'resume publication failed: repository upload returned HTTP %s for %s\n' \
          "$status" "$relative_path" >&2
        return 2
        ;;
    esac
    attempt=$((attempt + 1))
  done
  printf 'resume publication failed: upload exhausted %s attempts for %s\n' \
    "$TRANSPORT_ATTEMPTS" "$relative_path" >&2
  return 2
}

publication_task_for() {
  local artifact="$1"
  local project_name=""
  local publication=""

  case "$artifact" in
    *-iossimulatorarm64)
      project_name="${artifact%-iossimulatorarm64}"
      publication="IosSimulatorArm64"
      ;;
    *-iosarm64)
      project_name="${artifact%-iosarm64}"
      publication="IosArm64"
      ;;
    *-wasm-js)
      project_name="${artifact%-wasm-js}"
      publication="WasmJs"
      ;;
    *-android)
      project_name="${artifact%-android}"
      publication="Android"
      ;;
    *-jvm)
      project_name="${artifact%-jvm}"
      publication="Jvm"
      ;;
    *-js)
      project_name="${artifact%-js}"
      publication="Js"
      ;;
    *)
      project_name="$artifact"
      if grep -Eq \
        "^${GROUP}:${artifact}-(android|iosarm64|iossimulatorarm64|js|jvm|wasm-js):${VERSION}$" \
        "$NORMALIZED_COORDINATES"; then
        publication="KotlinMultiplatform"
      else
        publication="Maven"
      fi
      ;;
  esac

  [[ -d "$PROJECT_DIR/$project_name" ]] || {
    printf 'resume publication failed: no project directory maps to %s\n' "$artifact" >&2
    return 2
  }
  printf ':%s:publish%sPublicationTo%sRepository' \
    "$project_name" "$publication" "$REPOSITORY_NAME"
}

group_path="$(printf '%s' "$GROUP" | tr '.' '/')"
present_count=0
partial_count=0
missing_count=0
while IFS=: read -r ignored_group artifact ignored_version; do
  local_directory="$LOCAL_MAVEN_REPOSITORY/$group_path/$artifact/$VERSION"
  [[ -d "$local_directory" &&
    -f "$local_directory/$artifact-$VERSION.pom" ]] || {
    printf 'resume publication failed: staged Maven files are missing for %s\n' \
      "$artifact" >&2
    exit 2
  }
  coordinate="$GROUP:$artifact:$VERSION"
  if grep -Fxq "$coordinate" "$NORMALIZED_COMPLETED_COORDINATES"; then
    verify_completed_coordinate "$artifact" || exit $?
    printf '[resume-publish-sdk] verified completed %s\n' "$artifact"
    continue
  fi
  files_before="$(wc -l < "$PARTIAL_FILES" | tr -d ' ')"
  if [[ "$FRESH_UPLOAD" == true ]]; then
    collect_coordinate_files "$artifact" "$MISSING_FILES" || exit $?
    COORDINATE_PRESENT_FILES=0
    COORDINATE_MISSING_FILES=1
  else
    inspect_coordinate_files "$artifact" true || exit $?
  fi
  if [[ "$COORDINATE_MISSING_FILES" -eq 0 ]]; then
    present_count=$((present_count + 1))
    printf '[resume-publish-sdk] verified %s\n' "$artifact"
  elif [[ "$COORDINATE_PRESENT_FILES" -eq 0 ]]; then
    printf '%s:%s:%s\n' "$GROUP" "$artifact" "$VERSION" >> "$MISSING_COORDINATES"
    if [[ "$EXACT_FILES" == true ]]; then
      if [[ "$FRESH_UPLOAD" != true ]]; then
        tail -n "+$((files_before + 1))" "$PARTIAL_FILES" >> "$MISSING_FILES"
      fi
      printf '[resume-publish-sdk] absent %s -> exact staged files\n' "$artifact"
    else
      task="$(publication_task_for "$artifact")" || exit $?
      printf '%s\t%s\n' "$artifact" "$task" >> "$MISSING_TASKS"
      printf '[resume-publish-sdk] absent %s -> %s\n' "$artifact" "$task"
    fi
    missing_count=$((missing_count + 1))
    if [[ "$files_before" -gt 0 ]]; then
      head -n "$files_before" "$PARTIAL_FILES" > "$WORK_DIR/previous-files"
    else
      : > "$WORK_DIR/previous-files"
    fi
    mv "$WORK_DIR/previous-files" "$PARTIAL_FILES"
  else
    printf '%s\n' "$artifact" >> "$PARTIAL_ARTIFACTS"
    partial_count=$((partial_count + 1))
    printf '[resume-publish-sdk] partial %s missing_files=%s\n' \
      "$artifact" "$COORDINATE_MISSING_FILES"
  fi
done < "$NORMALIZED_COORDINATES"

printf 'MAGRATHEA_RESUME_PLAN total=%s completed=%s present=%s partial=%s missing=%s version=%s\n' \
  "$coordinate_count" "$completed_coordinate_count" "$present_count" \
  "$partial_count" "$missing_count" "$VERSION"

if [[ "$PLAN_ONLY" == true ]]; then
  while IFS=$'\t' read -r local_file relative_path; do
    [[ -n "$local_file" ]] || continue
    printf '[resume-publish-sdk] would repair %s\n' "$relative_path"
  done < "$PARTIAL_FILES"
  while IFS=$'\t' read -r artifact task; do
    [[ -n "$artifact" ]] || continue
    printf '[resume-publish-sdk] would publish %s -> %s\n' "$artifact" "$task"
  done < "$MISSING_TASKS"
  while IFS=$'\t' read -r local_file relative_path; do
    [[ -n "$local_file" ]] || continue
    printf '[resume-publish-sdk] would publish exact %s\n' "$relative_path"
  done < "$MISSING_FILES"
  printf 'MAGRATHEA_RESUME_PLAN_ONLY version=%s\n' "$VERSION"
  exit 0
fi

if [[ "$missing_count" -gt 0 && "$EXACT_FILES" != true ]]; then
  signing_key="${MAGRATHEA_SIGNING_KEY:-}"
  [[ -n "${signing_key//[[:space:]]/}" ]] || {
    printf 'resume publication failed: MAGRATHEA_SIGNING_KEY is required\n' >&2
    exit 2
  }
fi

repaired_file_count=0
if [[ "$partial_count" -gt 0 ]]; then
  for upload_phase in payload pom-signature pom; do
    while IFS=$'\t' read -r local_file relative_path; do
      case "$upload_phase:$relative_path" in
        payload:*.pom|payload:*.pom.asc) continue ;;
        pom-signature:*.pom.asc) ;;
        pom-signature:*) continue ;;
        pom:*.pom) ;;
        pom:*) continue ;;
      esac
      upload_file "$local_file" "$relative_path" || exit $?
      repaired_file_count=$((repaired_file_count + 1))
      printf '[resume-publish-sdk] repaired %s\n' "$relative_path"
    done < "$PARTIAL_FILES"
  done
  while IFS= read -r artifact; do
    : > "$PARTIAL_FILES"
    inspect_coordinate_files "$artifact" true || exit $?
    [[ "$COORDINATE_MISSING_FILES" -eq 0 ]] || {
      printf 'resume publication failed: repaired coordinate %s remains incomplete\n' \
        "$artifact" >&2
      exit 2
    }
  done < "$PARTIAL_ARTIFACTS"
fi

if [[ "$missing_count" -eq 0 ]]; then
  /bin/bash "$PROJECT_DIR/scripts/verify-remote-version-present" \
    "$REPOSITORY_URL" "$GROUP" "$VERSION" < "$NORMALIZED_COORDINATES"
  printf 'MAGRATHEA_RESUME_COMPLETE published=0 repaired_files=%s version=%s\n' \
    "$repaired_file_count" "$VERSION"
  exit 0
fi

if [[ "$EXACT_FILES" == true ]]; then
  published_file_count=0
  for upload_phase in payload pom-signature pom; do
    while IFS=$'\t' read -r local_file relative_path; do
      case "$upload_phase:$relative_path" in
        payload:*.pom|payload:*.pom.asc) continue ;;
        pom-signature:*.pom.asc) ;;
        pom-signature:*) continue ;;
        pom:*.pom) ;;
        pom:*) continue ;;
      esac
      upload_file "$local_file" "$relative_path" "$FRESH_UPLOAD" || exit $?
      published_file_count=$((published_file_count + 1))
      printf '[resume-publish-sdk] published exact %s\n' "$relative_path"
    done < "$MISSING_FILES"
  done

  while IFS=: read -r ignored_group artifact ignored_version; do
    : > "$PARTIAL_FILES"
    inspect_coordinate_files "$artifact" true || exit $?
    [[ "$COORDINATE_MISSING_FILES" -eq 0 ]] || {
      printf 'resume publication failed: published coordinate %s remains incomplete\n' \
        "$artifact" >&2
      exit 2
    }
  done < "$MISSING_COORDINATES"

  /bin/bash "$PROJECT_DIR/scripts/verify-remote-version-present" \
    "$REPOSITORY_URL" "$GROUP" "$VERSION" < "$NORMALIZED_COORDINATES"
  printf 'MAGRATHEA_RESUME_COMPLETE published=%s published_files=%s repaired_files=%s version=%s\n' \
    "$missing_count" "$published_file_count" "$repaired_file_count" "$VERSION"
  exit 0
fi

/bin/bash "$PROJECT_DIR/scripts/verify-remote-version-absent" \
  "$REPOSITORY_URL" "$GROUP" "$VERSION" < "$MISSING_COORDINATES"

PUBLISH_TASKS=()
while IFS=$'\t' read -r artifact task; do
  printf '[resume-publish-sdk] missing %s -> %s\n' "$artifact" "$task"
  PUBLISH_TASKS+=("$task")
done < "$MISSING_TASKS"

(
  cd "$PROJECT_DIR"
  ./gradlew \
    "${PUBLISH_TASKS[@]}" \
    "-Pmagrathea.publish.repositoryName=$REPOSITORY_NAME" \
    "-Pmagrathea.publish.repositoryUrl=$REPOSITORY_URL" \
    "-Pmagrathea.publish.preflightVerified=$GROUP:$VERSION" \
    --no-daemon \
    --stacktrace
)

/bin/bash "$PROJECT_DIR/scripts/verify-remote-version-present" \
  "$REPOSITORY_URL" "$GROUP" "$VERSION" < "$NORMALIZED_COORDINATES"
while IFS=: read -r ignored_group artifact ignored_version; do
  verify_completed_coordinate "$artifact" || exit $?
done < "$MISSING_COORDINATES"
printf 'MAGRATHEA_RESUME_COMPLETE published=%s repaired_files=%s version=%s\n' \
  "$missing_count" "$repaired_file_count" "$VERSION"
