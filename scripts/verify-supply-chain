#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "json"
require_relative "verify_normalized_sbom"

root = File.expand_path(ARGV.fetch(0))
version = ARGV.fetch(1)

def fail_contract(message)
  warn "supply-chain verification failed: #{message}"
  exit 1
end

def require_file(path)
  fail_contract("missing #{path}") unless File.file?(path)
  path
end

allowed_licenses = %w[Apache-2.0 MIT].freeze

published_modules = %w[
  magrathea-core
  magrathea-provider-api
  magrathea-provider-openai
  magrathea-provider-gemini
  magrathea-provider-anthropic
  magrathea-runtime
  magrathea-mcp
  magrathea-storage-room
  magrathea-credentials
  magrathea-policy
  magrathea-gateway-protocol
  magrathea-gateway-server
  magrathea-provider-gateway
  magrathea-chatbot
  magrathea-storage-web
  magrathea-web-client
].freeze

wrapper_properties_path = require_file(File.join(root, "gradle", "wrapper", "gradle-wrapper.properties"))
wrapper_jar_path = require_file(File.join(root, "gradle", "wrapper", "gradle-wrapper.jar"))
wrapper_properties = File.readlines(wrapper_properties_path, chomp: true).map do |line|
  next if line.empty? || line.start_with?("#")

  line.split("=", 2) if line.include?("=")
end.compact.to_h
expected_distribution = "https\\://services.gradle.org/distributions/gradle-9.3.1-bin.zip"
expected_distribution_sha = "b266d5ff6b90eada6dc3b20cb090e3731302e553a27c5d3e4df1f0d76beaff06"
expected_wrapper_jar_sha = "b3a875ddc1f044746e1b1a55f645584505f4a10438c1afea9f15e92a7c42ec13"
fail_contract("Gradle distribution URL is not the reviewed 9.3.1 binary") unless
  wrapper_properties["distributionUrl"] == expected_distribution
fail_contract("Gradle distribution checksum is missing or unreviewed") unless
  wrapper_properties["distributionSha256Sum"] == expected_distribution_sha
fail_contract("Gradle wrapper URL validation must remain enabled") unless
  wrapper_properties["validateDistributionUrl"] == "true"
fail_contract("Gradle wrapper JAR does not match the official 9.3.1 wrapper") unless
  Digest::SHA256.file(wrapper_jar_path).hexdigest == expected_wrapper_jar_sha

catalog_path = require_file(File.join(root, "gradle", "libs.versions.toml"))
File.readlines(catalog_path, chomp: true).each do |line|
  next if line.lstrip.start_with?("#")

  line.scan(/(?:^|\s)version\s*=\s*"([^"]+)"|^[-A-Za-z0-9_.]+\s*=\s*"([^"]+)"/) do |inline, catalog|
    declared = inline || catalog
    fail_contract("dynamic/SNAPSHOT version in version catalog: #{declared}") if declared.match?(/SNAPSHOT|latest|\+/i)
  end
end

raw_sbom_path = require_file(File.join(root, "build", "reports", "cyclonedx", "bom.json"))
sbom = JSON.parse(File.read(raw_sbom_path))
fail_contract("SBOM is not CycloneDX") unless sbom["bomFormat"] == "CycloneDX"
fail_contract("SBOM must use CycloneDX 1.6") unless sbom["specVersion"] == "1.6"
metadata_component = sbom.dig("metadata", "component") || fail_contract("SBOM has no metadata component")
fail_contract("SBOM root group mismatch") unless metadata_component["group"] == "saien.magrathea"
fail_contract("SBOM root name mismatch") unless metadata_component["name"] == "magrathea"
fail_contract("SBOM root version mismatch") unless metadata_component["version"] == version

components = sbom.fetch("components")
web_ledger_path = require_file(File.join(root, "third-party", "web-runtime-licenses.json"))
web_ledger = JSON.parse(File.read(web_ledger_path))
fail_contract("unsupported Web runtime license ledger format") unless web_ledger["formatVersion"] == 1
web_license_definitions = web_ledger.fetch("licenses") do
  fail_contract("Web runtime license ledger has no licenses")
end
web_npm_components = web_ledger.fetch("npmComponents") do
  fail_contract("Web runtime license ledger has no npm components")
end
fail_contract("Web runtime license ledger has no npm components") if web_npm_components.empty?

reviewed_web_names = {}
web_sbom_components = web_npm_components.map do |component|
  name = component["name"].to_s
  version_value = component["version"].to_s
  role = component["role"].to_s
  repository = component["repository"].to_s
  license_id = component["license"].to_s
  fail_contract("invalid Web npm component name: #{name}") unless
    name.match?(/\A(?:@[A-Za-z0-9._-]+\/)?[A-Za-z0-9._-]+\z/)
  fail_contract("duplicate Web npm component: #{name}") if reviewed_web_names.key?(name)
  fail_contract("unversioned Web npm component: #{name}") if version_value.empty?
  fail_contract("dynamic/SNAPSHOT Web npm component: #{name}:#{version_value}") if
    version_value.match?(/SNAPSHOT|latest|\+/i)
  fail_contract("invalid Web npm component role: #{name}:#{role}") unless
    %w[runtimeDependency bundleGenerator].include?(role)
  fail_contract("unsafe Web npm repository URL: #{name}") unless repository.start_with?("https://")
  license_details = web_license_definitions[license_id]
  fail_contract("unknown Web npm license: #{name}:#{license_id}") unless license_details.is_a?(Hash)
  spdx = license_details["spdx"].to_s
  fail_contract("license not allowed: npm:#{name}:#{spdx}") unless allowed_licenses.include?(spdx)

  reviewed_web_names[name] = true
  encoded_name = name.start_with?("@") ? "%40#{name.delete_prefix('@')}" : name
  purl = "pkg:npm/#{encoded_name}@#{version_value}"
  {
    "type" => "library",
    "name" => name,
    "version" => version_value,
    "bom-ref" => purl,
    "purl" => purl,
    "scope" => "required",
    "licenses" => [{ "license" => { "id" => spdx } }],
    "externalReferences" => [{ "type" => "vcs", "url" => repository }],
    "properties" => [{ "name" => "magrathea:webBundleRole", "value" => role }],
  }
end
web_sbom_components.sort_by! { |component| [component.fetch("name"), component.fetch("version")] }
web_refs = web_sbom_components.map { |component| component.fetch("bom-ref") }
colliding_web_ref = components.find { |component| web_refs.include?(component["bom-ref"]) }
fail_contract("Web npm component already exists in generated SBOM: #{colliding_web_ref['bom-ref']}") if colliding_web_ref
components.concat(web_sbom_components)
fail_contract("production SBOM is unexpectedly small") if components.length < 50
internal = components.select { |component| component["group"] == "saien.magrathea" }
actual_modules = internal.map { |component| component.fetch("name") }.uniq.sort
fail_contract("published module set differs from SBOM: #{actual_modules}") unless actual_modules == published_modules.sort

test_only = lambda do |component|
  group = component["group"].to_s
  name = component["name"].to_s
  group == "junit" || group.start_with?("org.junit") || group.start_with?("androidx.test") ||
    group == "com.android.tools.utp" || group == "com.google.testing.platform" ||
    (group == "org.jetbrains.kotlin" && name.start_with?("kotlin-test")) ||
    (group == "org.jetbrains.kotlinx" && name.start_with?("kotlinx-coroutines-test")) ||
    (group == "io.ktor" && (name.include?("-test") || name.include?("-mock"))) ||
    (group == "com.squareup.okhttp3" && name == "mockwebserver")
end
test_component = components.find(&test_only)
fail_contract("test-only component entered production SBOM: #{test_component['group']}:#{test_component['name']}") if test_component

components.each do |component|
  version_value = component["version"].to_s
  fail_contract("dynamic/SNAPSHOT component in SBOM: #{component['name']}:#{version_value}") if
    version_value.match?(/SNAPSHOT|latest|\+/i)
  next if component["group"] == "saien.magrathea"

  licenses = Array(component["licenses"]).map do |entry|
    entry.dig("license", "id") || entry.dig("license", "name") || entry["expression"]
  end.compact
  fail_contract("unknown license: #{component['group']}:#{component['name']}:#{version_value}") if licenses.empty?
  usable = licenses.any? do |license|
    allowed_licenses.any? { |allowed| license == allowed || license.split(/\s+OR\s+/).include?(allowed) }
  end
  fail_contract("license not allowed: #{component['group']}:#{component['name']}:#{licenses.join(' OR ')}") unless usable
end

project_license = [{ "license" => { "id" => "MIT" } }]
metadata_component["licenses"] = project_license
internal.each { |component| component["licenses"] = project_license }
root_ref = metadata_component.fetch("bom-ref")
dependencies = sbom["dependencies"] ||= []
dependencies.reject! { |dependency| dependency["ref"] == root_ref }
dependencies << {
  "ref" => root_ref,
  "dependsOn" => (internal.map { |component| component.fetch("bom-ref") } + web_refs).uniq.sort,
}
web_refs.each do |web_ref|
  dependencies << { "ref" => web_ref, "dependsOn" => [] } unless
    dependencies.any? { |dependency| dependency["ref"] == web_ref }
end

begin
  MagratheaNormalizedSbom.verify!(sbom, web_ledger)
rescue MagratheaNormalizedSbom::VerificationError => error
  fail_contract(error.message)
end

reports = File.join(root, "build", "reports", "supply-chain")
FileUtils.mkdir_p(reports)
normalized_sbom_path = File.join(reports, "magrathea-sbom.cdx.json")
File.write(normalized_sbom_path, JSON.pretty_generate(sbom) + "\n")

license_rows = components.map do |component|
  licenses = Array(component["licenses"]).map do |entry|
    entry.dig("license", "id") || entry.dig("license", "name") || entry["expression"]
  end.compact
  [component["group"].to_s, component["name"].to_s, component["version"].to_s, licenses.sort.join(" OR ")]
end.uniq.sort
license_report_path = File.join(reports, "third-party-licenses.tsv")
File.open(license_report_path, "w") do |file|
  file.puts "group\tname\tversion\tlicenses"
  license_rows.each { |row| file.puts row.join("\t") }
end

package_lock_path = require_file(File.join(root, "tooling", "web-browser-e2e", "package-lock.json"))
package_lock = JSON.parse(File.read(package_lock_path))
fail_contract("npm lockfileVersion must be 3") unless package_lock["lockfileVersion"] == 3
package_lock.fetch("packages").each do |path, package|
  next if path.empty?

  resolved = package["resolved"]
  integrity = package["integrity"]
  fail_contract("npm package is not registry-pinned: #{path}") unless resolved&.start_with?("https://registry.npmjs.org/")
  fail_contract("npm package has no SHA-512 integrity: #{path}") unless integrity&.start_with?("sha512-")
end
require_file(File.join(root, "kotlin-js-store", "yarn.lock"))

puts "MAGRATHEA_SUPPLY_CHAIN_PASS components=#{components.length} licenses=#{license_rows.length}"
