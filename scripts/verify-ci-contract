#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="${1:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

ruby - "$ROOT_DIR" <<'RUBY'
require "yaml"

root = ARGV.fetch(0)
gradle_properties = File.read(File.join(root, "gradle.properties"))

ACTION_PINS = {
  "googleapis/release-please-action" => "5c625bfb5d1ff62eadeeb3772007f7f66fdcf071",
  "actions/setup-node" => "49933ea5288caeca8642d1e84afbd3f7d6820020",
  "actions/checkout" => "df4cb1c069e1874edd31b4311f1884172cec0e10",
  "actions/setup-java" => "0f481fcb613427c0f801b606911222b5b6f3083a",
  "actions/upload-artifact" => "ea165f8d65b6e75b540449e92b4886f43607fa02",
  "actions/download-artifact" => "d3f86a106a0bac45b974a628896c90dbdf5c8093",
  "actions/attest-build-provenance" => "0f67c3f4856b2e3261c31976d6725780e5e4c373",
  "actions/dependency-review-action" => "2031cfc080254a8a887f58cffee85186f0e49e48",
  "gradle/actions/wrapper-validation" => "3f131e8634966bd73d06cc69884922b02e6faf92",
  "gradle/actions/setup-gradle" => "3f131e8634966bd73d06cc69884922b02e6faf92",
}.freeze

def fail_contract(message)
  warn "CI contract verification failed: #{message}"
  exit 1
end

def load_workflow(root, name)
  path = File.join(root, ".github", "workflows", name)
  fail_contract("missing #{name}") unless File.file?(path)
  [path, YAML.safe_load(File.read(path), aliases: true)]
rescue Psych::SyntaxError => error
  fail_contract("invalid #{name}: #{error.message}")
end

def triggers(document)
  document["on"] || document[true] || {}
end

def all_steps(document)
  document.fetch("jobs", {}).values.flat_map { |job| job.fetch("steps", []) }
end

def action_uses(document)
  all_steps(document).map { |step| step["uses"] }.compact
end

def retains_failure_diagnostics?(document)
  all_steps(document).any? do |step|
    next false unless step["uses"]&.start_with?("actions/upload-artifact@")
    next false unless step["if"].to_s.include?("failure()")

    artifact = step.fetch("with", {})
    paths = artifact["path"].to_s
    artifact["if-no-files-found"] == "warn" &&
      paths.include?("test-results") &&
      paths.include?("web-gateway-e2e-server.log")
  end
end

def run_commands(document)
  all_steps(document).map { |step| step["run"] }.compact.join("\n")
end

def matrix_tasks(document, job_name)
  entries = document
    .fetch("jobs", {})
    .fetch(job_name, {})
    .dig("strategy", "matrix", "include")
  Array(entries).map { |entry| entry["gradle_task"] }.compact
end

def pinned_action(action)
  repository, ref = action.split("@", 2)
  ACTION_PINS[repository] == ref
end

fail_contract("Gradle build cache must be enabled") unless
  gradle_properties.match?(/^org\.gradle\.caching=true$/)
fail_contract("Gradle project parallelism must be enabled") unless
  gradle_properties.match?(/^org\.gradle\.parallel=true$/)

[
  File.join(root, "karma.config.d", "mocha-timeout.js"),
  File.join(root, "samples", "web-chat", "karma.config.d", "mocha-timeout.js"),
].each do |path|
  fail_contract("missing bounded browser-test timeout config at #{path.delete_prefix("#{root}/")}") unless
    File.file?(path)
  fail_contract("browser-test timeout config must set Mocha to 20 seconds at #{path.delete_prefix("#{root}/")}") unless
    File.read(path).match?(/\btimeout:\s*20_000\b/)
end

%w[
  saien.magrathea.kmp-web-library.gradle.kts
  saien.magrathea.kmp-web-only-library.gradle.kts
].each do |name|
  path = File.join(root, "build-logic", "src", "main", "kotlin", name)
  wiring = File.read(path).scan('useConfigDirectory(rootProject.file("karma.config.d"))')
  fail_contract("#{name} must wire both JS and Wasm browser tests to the shared Karma config") unless
    wiring.length == 2
end

%w[
  saien.magrathea.kmp-library.gradle.kts
  saien.magrathea.kmp-web-library.gradle.kts
].each do |name|
  path = File.join(root, "build-logic", "src", "main", "kotlin", name)
  fail_contract("#{name} must leave final Apple framework construction to the consumer boundary") if
    File.read(path).include?("binaries.framework")
end

published_consumer = File.read(File.join(root, "tooling", "kmp-consumer", "build.gradle.kts"))
fail_contract("published KMP consumer must define one static framework across both Apple targets") unless
  published_consumer.include?("iosTarget.binaries.framework") &&
    published_consumer.include?("isStatic = true")

root_build = File.read(File.join(root, "build.gradle.kts"))
[
  "linkReleaseFrameworkIosArm64",
  "linkReleaseFrameworkIosSimulatorArm64",
  "Missing published-consumer",
].each do |evidence|
  fail_contract("published Apple consumer gate missing #{evidence}") unless
    root_build.include?(evidence)
end

verify_path, verify = load_workflow(root, "verify.yml")
nightly_path, nightly = load_workflow(root, "nightly.yml")
release_path, release = load_workflow(root, "release.yml")
please_path, please = load_workflow(root, "release-please.yml")

verify_triggers = triggers(verify)
verify_push = verify_triggers["push"]
fail_contract("verify.yml must trigger on every PR") unless
  verify_triggers.key?("pull_request")
fail_contract("verify.yml must limit main pushes to release version changes") unless
  verify_push.is_a?(Hash) &&
    verify_push.keys.sort == %w[branches paths] &&
    Array(verify_push["branches"]) == ["main"] &&
    Array(verify_push["paths"]) == ["gradle.properties"]
%w[linux-gate apple-gate web-gate dependency-review].each do |job|
  fail_contract("verify.yml missing #{job}") unless verify.fetch("jobs", {}).key?(job)
end
fail_contract("verify.yml missing pinned dependency review action") unless
  action_uses(verify).any? { |action| action.start_with?("actions/dependency-review-action@") && pinned_action(action) }
required_apple_tasks = %w[
  verifyKmpPublishedConsumerApple
  verifyKmpAppleTests
]
fail_contract("verify.yml does not run Linux and Web gates") unless
  run_commands(verify).include?("verifySdkLinux") &&
    run_commands(verify).include?("verifySdkWeb")
linux_checkout = verify.fetch("jobs", {}).fetch("linux-gate", {}).fetch("steps", []).find do |step|
  step["uses"]&.start_with?("actions/checkout@")
end
fail_contract("linux gate must fetch full history for append-only schema comparison") unless
  linux_checkout&.dig("with", "fetch-depth") == 0
fail_contract("verify.yml must compare the persistence schema ledger with its base commit") unless
  run_commands(verify).include?("verify_persistence_schemas.py") &&
    run_commands(verify).include?("--baseline") &&
    run_commands(verify).include?("persistence/schema-ledger.json")
fail_contract("verify.yml must retain Web failure diagnostics") unless
  retains_failure_diagnostics?(verify)
fail_contract("verify.yml does not run the complete Apple gate matrix") unless
  matrix_tasks(verify, "apple-gate").sort == required_apple_tasks.sort

fail_contract("nightly.yml must support schedule and manual dispatch") unless
  triggers(nightly).key?("schedule") && triggers(nightly).key?("workflow_dispatch")
%w[linux-nightly apple-nightly].each do |job|
  fail_contract("nightly.yml missing #{job}") unless nightly.fetch("jobs", {}).key?(job)
end
fail_contract("nightly.yml must report missing live credentials explicitly") unless
  run_commands(nightly).include?("MAGRATHEA_LIVE_NOT_RUN")
fail_contract("nightly.yml must run the Web gate") unless run_commands(nightly).include?("verifySdkWeb")
fail_contract("nightly.yml does not run the complete Apple gate matrix") unless
  matrix_tasks(nightly, "apple-nightly").sort == required_apple_tasks.sort
fail_contract("nightly.yml must scan the production SBOM with checksum-pinned OSV-Scanner 2.3.8") unless
  run_commands(nightly).include?("osv-scanner_linux_amd64") &&
    run_commands(nightly).include?("bc98e15319ed0d515e3f9235287ba53cdc5535d576d24fd573978ecfe9ab92dc") &&
    run_commands(nightly).include?("magrathea-sbom.cdx.json")
fail_contract("nightly.yml must retain the OSV report") unless
  action_uses(nightly).any? { |action| action.start_with?("actions/upload-artifact@") && pinned_action(action) }
fail_contract("nightly.yml must surface OSV findings in logs and the job summary") unless
  run_commands(nightly).include?("OSV_FINDING") &&
    run_commands(nightly).include?("GITHUB_STEP_SUMMARY") &&
    run_commands(nightly).include?("https://osv.dev/vulnerability/")

release_triggers = triggers(release).keys
fail_contract("release.yml must be manual-only") unless release_triggers == ["workflow_dispatch"]
fail_contract("release.yml must expose a version-bound run name for safe orchestration") unless
  release["run-name"] == 'Release Magrathea SDK ${{ inputs.version }}'
release_inputs = triggers(release).dig("workflow_dispatch", "inputs") || {}
version_input = release_inputs["version"]
commit_input = release_inputs["commit"]
fail_contract("release.yml must require explicit version and commit inputs") unless
  release_inputs.keys.sort == %w[ci_run commit pull_request version] &&
    version_input.is_a?(Hash) &&
    version_input["required"] == true &&
    version_input["type"] == "string" &&
    commit_input.is_a?(Hash) &&
    commit_input["required"] == true &&
    commit_input["type"] == "string"
%w[release-candidate prepare-publish publish-maven github-release].each do |job|
  fail_contract("release.yml missing #{job}") unless release.fetch("jobs", {}).key?(job)
end

release_runs = run_commands(release)
authorization = all_steps(release).find { |step| step["run"]&.include?("scripts/release validate") }
fail_contract("release.yml must bind publication to its Release PR, commit, and CI run") unless
  authorization && %w[--version --commit --pull-request --ci-run --run-id].all? { |arg| authorization["run"].include?(arg) }
fail_contract("release.yml must check out the authorized commit") unless
  all_steps(release).first.dig("with", "ref") == '${{ inputs.commit }}'
fail_contract("release.yml must restore the original candidate on repeated preparation") unless
  all_steps(release).any? { |step| step["uses"]&.start_with?("actions/download-artifact@") &&
    step["if"].to_s.include?("candidate_exists == 'true'") }
release_preparation = all_steps(release).find do |step|
  step["run"]&.include?("scripts/publish-sdk") &&
    step["run"]&.include?("--prepare-only") &&
    step["run"]&.include?("--verified-ci-run")
end
fail_contract("release.yml must exercise the exact side-effect-free release preparation path") unless
  release_preparation
fail_contract("release.yml preparation must have a bounded step timeout") unless
  release_preparation["timeout-minutes"].to_i.between?(1, 120)
fail_contract("release.yml must emit five-minute preparation heartbeats") unless
  release_preparation["run"].include?("scripts/run-with-heartbeat") &&
    release_preparation["run"].include?("--interval 300")
fail_contract("release.yml preparation must receive repository signing material") unless
  release_preparation.dig("env", "MAGRATHEA_SIGNING_KEY")&.include?("secrets.MAGRATHEA_SIGNING_KEY") &&
    release_preparation.dig("env", "MAGRATHEA_SIGNING_PASSWORD")&.include?("secrets.MAGRATHEA_SIGNING_PASSWORD")
fail_contract("release.yml must retain preparation failure diagnostics") unless
  retains_failure_diagnostics?(release)
fail_contract("release preparation must skip SDK assembly when a candidate exists") unless
  release_preparation["if"].to_s.include?("candidate_exists != 'true'")
fail_contract("release.yml must render notes from committed release metadata") unless
  release_runs.include?("scripts/release_notes.py --check")
fail_contract("release.yml must complete the Release Please lifecycle") unless
  release_runs.include?("scripts/release complete")

local_candidate_verification = all_steps(release).find do |step|
  step["run"]&.include?("scripts/verify-release-candidate")
end
fail_contract("release.yml must verify the completed candidate against the checked-in release key") unless
  local_candidate_verification
fail_contract("release.yml candidate verification must have a bounded step timeout") unless
  local_candidate_verification["timeout-minutes"].to_i.between?(1, 30)
fail_contract("release.yml must upload the immutable candidate with the reviewed action") unless
  action_uses(release).any? { |action| action.start_with?("actions/upload-artifact@") && pinned_action(action) }
fail_contract("release.yml must attest the outer candidate exactly once") unless
  action_uses(release).count { |action|
    action.start_with?("actions/attest-build-provenance@") && pinned_action(action)
  } == 1 && all_steps(release).any? { |step|
    step["uses"]&.start_with?("actions/attest-build-provenance@") &&
      step.dig("with", "subject-path")&.include?("release-candidate.zip")
  }
fail_contract("release.yml must not boot a simulator after exact-SHA CI") if
  release_runs.include?("simctl")
fail_contract("release.yml must not promote a candidate from another workflow run") if
  release_runs.include?("CANDIDATE_RUN_ID") || release.to_s.include?("promoted-candidate")

release_jobs = release.fetch("jobs")
candidate_runs = run_commands("jobs" => { "release-candidate" => release_jobs.fetch("release-candidate") })
prepare_runs = run_commands("jobs" => { "prepare-publish" => release_jobs.fetch("prepare-publish") })
publish_runs = run_commands("jobs" => { "publish-maven" => release_jobs.fetch("publish-maven") })
github_release_runs = run_commands("jobs" => { "github-release" => release_jobs.fetch("github-release") })
candidate_verification = candidate_runs.index("scripts/verify-release-candidate")
tag_creation = prepare_runs.index('git tag -a "$RELEASE_TAG"')
tag_validation = prepare_runs.index('scripts/verify-release-tag "$RELEASE_TAG"')
tag_push = prepare_runs.index('git push origin "refs/tags/$RELEASE_TAG"')
publication = publish_runs.index("scripts/resume-publish-sdk")
remote_validation = github_release_runs.index("scripts/verify-remote-version-present")
consumer_validation = github_release_runs.index("-p tooling/kmp-consumer")
release_creation = github_release_runs.index("gh release create")
fail_contract("release.yml must create, validate, and push one annotated tag after candidate verification") unless
  candidate_verification && tag_creation && tag_validation && tag_push &&
    release_jobs.dig("prepare-publish", "needs") == "release-candidate" &&
    tag_creation < tag_validation && tag_validation < tag_push
fail_contract("release.yml must publish only after the annotated tag is authorized") unless
  publication && release_jobs.dig("publish-maven", "needs") == "prepare-publish"
fail_contract("release.yml must use manifest-bound exact-byte publication") unless
  publication &&
    release_runs.include?("--exact-files") &&
    release_runs.include?("--manifest-file") &&
    release_runs.include?("select-publishing-coordinates")
fail_contract("release.yml must emit five-minute publication heartbeats") unless
  release_runs.include?("scripts/run-with-heartbeat") &&
    release_runs.include?("--interval 300")
non_candidate_jobs = release.fetch("jobs", {}).reject { |name, _job| name == "release-candidate" }
fail_contract("only candidate preparation may receive release signing material") if
  non_candidate_jobs.to_s.include?("MAGRATHEA_SIGNING_KEY") ||
    non_candidate_jobs.to_s.include?("MAGRATHEA_SIGNING_PASSWORD")

publish_strategy = release.dig("jobs", "publish-maven", "strategy") || {}
publish_matrix = publish_strategy.dig("matrix", "include") || []
fail_contract("release.yml must publish four logical-module shards") unless
  publish_matrix.length == 4 &&
    publish_strategy["max-parallel"] == 4 &&
    publish_matrix.all? { |entry| entry["name"] && entry["modules"] }
expected_publish_modules = %w[
  magrathea-core
  magrathea-provider-api
  magrathea-provider-openai
  magrathea-provider-gemini
  magrathea-provider-anthropic
  magrathea-runtime
  magrathea-mcp
  magrathea-storage-room
  magrathea-credentials
  magrathea-policy
  magrathea-gateway-protocol
  magrathea-gateway-server
  magrathea-provider-gateway
  magrathea-chatbot
  magrathea-storage-web
  magrathea-web-client
]
actual_publish_modules = publish_matrix.flat_map { |entry| entry.fetch("modules").split }
fail_contract("release.yml shards must own every logical module exactly once") unless
  actual_publish_modules.length == actual_publish_modules.uniq.length &&
    actual_publish_modules.sort == expected_publish_modules.sort
fail_contract("release.yml must support same-run retries of a partial version") unless
  release_runs.include?("--plan-only") &&
    release_runs.include?("mode=resume") &&
    release_runs.include?("--fresh") &&
    release.to_s.include?("github.run_attempt") &&
    release_runs.include?('RELEASE_RUN_ATTEMPT" != 1') &&
    release_runs.include?("cmp \"$asset\"") &&
    !release_runs.include?("--clobber")
fail_contract("release.yml must validate remote coordinates before creating the release") unless
  remote_validation && release_creation && remote_validation < release_creation
fail_contract("release.yml must resolve JVM and Android variants from an isolated remote consumer") unless
  consumer_validation &&
    release_runs.include?("jvmTest compileAndroidMain") &&
    consumer_validation < release_creation
fail_contract("release.yml must create the GitHub Release only after all Maven shards pass") unless
  Array(release_jobs.dig("github-release", "needs")).sort == %w[prepare-publish publish-maven].sort
fail_contract("release.yml must download the same-run candidate with the reviewed action") unless
  action_uses(release).any? { |action| action.start_with?("actions/download-artifact@") && pinned_action(action) }
checkout_step = all_steps(release).find { |step| step["uses"]&.start_with?("actions/checkout@") }
fail_contract("release.yml must fetch full source history") unless
  checkout_step&.dig("with", "fetch-depth") == 0

{
  verify_path => verify,
  nightly_path => nightly,
  release_path => release,
  please_path => please,
}.each do |path, workflow|
  uses = action_uses(workflow)
  fail_contract("#{File.basename(path)} must use the reviewed checkout commit") unless
    uses.any? { |action| action.start_with?("actions/checkout@") && pinned_action(action) }
  if %w[verify.yml nightly.yml release.yml].include?(File.basename(path))
    fail_contract("#{File.basename(path)} must use the reviewed setup-java commit") unless
      uses.any? { |action| action.start_with?("actions/setup-java@") && pinned_action(action) }
    fail_contract("#{File.basename(path)} must use the reviewed Gradle cache action") unless
      uses.any? { |action| action.start_with?("gradle/actions/setup-gradle@") && pinned_action(action) }
    fail_contract("#{File.basename(path)} must validate the Gradle wrapper") unless
      uses.any? { |action| action.start_with?("gradle/actions/wrapper-validation@") && pinned_action(action) }
  end
  uses.each do |action|
    repository, ref = action.split("@", 2)
    fail_contract("#{File.basename(path)} uses an unreviewed action #{repository}") unless ACTION_PINS.key?(repository)
    fail_contract("#{File.basename(path)} action #{repository} is not pinned to a 40-character commit") unless
      ref&.match?(/\A[0-9a-f]{40}\z/)
    fail_contract("#{File.basename(path)} action #{repository} does not match the reviewed commit") unless
      pinned_action(action)
  end
end

{
  verify_path => verify,
  nightly_path => nightly,
  release_path => release,
  please_path => please,
}.each do |path, workflow|
  permissions = workflow.fetch("permissions", {})
  fail_contract("#{File.basename(path)} must keep contents read-only") unless permissions["contents"] == "read"
end

candidate_permissions = release.fetch("jobs", {}).fetch("release-candidate", {}).fetch("permissions", {})
fail_contract("candidate preparation needs source/artifact read and provenance write") unless
  candidate_permissions == {
    "contents" => "read",
    "actions" => "read",
    "pull-requests" => "read",
    "id-token" => "write",
    "attestations" => "write",
  }

prepare_permissions = release.fetch("jobs", {}).fetch("prepare-publish", {}).fetch("permissions", {})
fail_contract("tag authorization needs contents write plus source/artifact/package read") unless
  prepare_permissions == {
    "contents" => "write",
    "actions" => "read",
    "packages" => "read",
  }

package_permissions = release.fetch("jobs", {}).fetch("publish-maven", {}).fetch("permissions", {})
fail_contract("exact publication must have only packages write plus source/artifact read") unless
  package_permissions == {
    "contents" => "read",
    "actions" => "read",
    "packages" => "write",
  }
github_release_permissions = release.fetch("jobs", {}).fetch("github-release", {}).fetch("permissions", {})
fail_contract("GitHub Release creation needs contents: write") unless
  github_release_permissions["contents"] == "write"
fail_contract("remote consumer verification needs packages: read") unless
  github_release_permissions["packages"] == "read"
fail_contract("GitHub Release job has unexpected permissions") unless
  github_release_permissions.keys.sort == %w[actions contents packages issues pull-requests].sort

fail_contract("Release Please must only maintain PRs") unless
  all_steps(please).any? { |step| step["uses"]&.start_with?("googleapis/release-please-action@") &&
    step.dig("with", "skip-github-release") == true }
fail_contract("bot PR verification must be explicitly dispatched") unless
  triggers(verify).key?("workflow_dispatch") && run_commands(please).include?("gh workflow run verify.yml")
fail_contract("publication request must follow the complete matrix on a main push") unless
  verify.dig("jobs", "publish", "if") == "github.event_name == 'push'" &&
    Array(verify.dig("jobs", "publish", "needs")).sort == %w[apple-gate linux-gate web-gate] &&
    run_commands(verify).include?("scripts/release request")

puts "MAGRATHEA_CI_CONTRACT_PASS workflows=4 release=single-run promotion=exact-byte shards=4"
RUBY
