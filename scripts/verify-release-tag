#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TAG="${1:?usage: verify-release-tag TAG}"

[[ "$TAG" == v* ]] || {
  printf 'release tag verification failed: tag must start with v\n' >&2
  exit 2
}
VERSION="${TAG#v}"
[[ "$VERSION" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$ ]] || {
  printf 'release tag verification failed: %s is not a supported SemVer tag\n' "$TAG" >&2
  exit 2
}

configured_version="$(awk -F= '$1 == "magrathea.version" { print substr($0, index($0, "=") + 1); exit }' \
  "$ROOT_DIR/gradle.properties")"
[[ "$VERSION" == "$configured_version" ]] || {
  printf 'release tag verification failed: tag %s does not match magrathea.version=%s\n' \
    "$TAG" "$configured_version" >&2
  exit 2
}

release_date="$(awk -v prefix="## $VERSION — " '
  index($0, prefix) == 1 {
    print substr($0, length(prefix) + 1)
    exit
  }
' "$ROOT_DIR/CHANGELOG.md")"
[[ "$release_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || {
  printf 'release tag verification failed: CHANGELOG entry is missing a release date\n' >&2
  exit 2
}
release_notes="$ROOT_DIR/docs/releases/$TAG.md"
[[ -s "$release_notes" ]] || {
  printf 'release tag verification failed: missing release notes at %s\n' "$release_notes" >&2
  exit 2
}

git -C "$ROOT_DIR" diff --quiet
git -C "$ROOT_DIR" diff --cached --quiet
[[ "$(git -C "$ROOT_DIR" cat-file -t "refs/tags/$TAG")" == "tag" ]] || {
  printf 'release tag verification failed: %s must be an annotated tag\n' "$TAG" >&2
  exit 2
}
[[ "$(git -C "$ROOT_DIR" rev-parse "refs/tags/$TAG^{commit}")" == "$(git -C "$ROOT_DIR" rev-parse HEAD)" ]] || {
  printf 'release tag verification failed: checked-out commit does not match %s\n' "$TAG" >&2
  exit 2
}
if git -C "$ROOT_DIR" show-ref --verify --quiet refs/remotes/origin/main; then
  git -C "$ROOT_DIR" merge-base --is-ancestor HEAD origin/main || {
    printf 'release tag verification failed: tagged commit is not reachable from origin/main\n' >&2
    exit 2
  }
fi

printf '%s\n' "$VERSION"
